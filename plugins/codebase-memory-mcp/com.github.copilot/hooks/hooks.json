{
    "version": 1,
    "description": "Augment session and subagent starts with codebase-memory-mcp graph context and route searches back to the skill",
    "hooks": {
        "PostToolUse": [
            {
                "matcher": "Grep|Glob",
                "type": "command",
                "command": "node ${PLUGIN_ROOT}/scripts/codebase-memory-hint PostToolUse"
            }
        ],
        "SessionStart": [
            {
                "type": "command",
                "command": "codebase-memory-mcp hook-augment --event SessionStart --dialect copilot",
                "timeoutSec": 5
            }
        ],
        "SubagentStart": [
            {
                "type": "command",
                "command": "codebase-memory-mcp hook-augment --event SubagentStart --dialect copilot",
                "timeoutSec": 5
            }
        ]
    }
}
