{
    "version": 1,
    "description": "Augment session and subagent starts with codebase-memory-mcp graph context",
    "hooks": {
        "SessionStart": [
            {
                "type": "command",
                "command": "codebase-memory-mcp hook-augment --event SessionStart --dialect copilot",
                "timeoutSec": 5
            }
        ],
        "SubagentStart": [
            {
                "type": "command",
                "command": "codebase-memory-mcp hook-augment --event SubagentStart --dialect copilot",
                "timeoutSec": 5
            }
        ]
    }
}
