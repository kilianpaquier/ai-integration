{
    "version": 1,
    "description": "Remind the agent to prefer Context7 over training data or a raw web search for library/framework/SDK/API docs",
    "hooks": {
        "PostToolUse": [
            {
                "matcher": "WebFetch|WebSearch",
                "type": "command",
                "command": "node ${PLUGIN_ROOT}/scripts/context7-hint.js PostToolUse"
            }
        ],
        "SessionStart": [
            {
                "matcher": "startup|resume|clear|compact",
                "type": "command",
                "command": "node ${PLUGIN_ROOT}/scripts/context7-hint.js SessionStart"
            }
        ],
        "SubagentStart": [
            {
                "matcher": "*",
                "type": "command",
                "command": "node ${PLUGIN_ROOT}/scripts/context7-hint.js SubagentStart"
            }
        ]
    }
}
