{
    "version": 1,
    "hooks": {
        "beforeSubmitPrompt": [
            {
                "command": "node ${PLUGIN_ROOT}/scripts/caveman-mode.js",
                "timeout": 10
            }
        ],
        "sessionStart": [
            {
                "command": "node ${PLUGIN_ROOT}/scripts/caveman-activate.js SessionStart"
            }
        ]
    }
}
