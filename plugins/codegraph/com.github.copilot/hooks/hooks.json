{
    "version": 1,
    "description": "Augment session and subagent starts with codegraph knowledge graph context",
    "hooks": {
        "PostToolUse": [
            {
                "matcher": "Grep|Glob",
                "type": "command",
                "command": "node ${PLUGIN_ROOT}/scripts/codegraph-hook.js PostToolUse"
            }
        ],
        "SessionStart": [
            {
                "type": "command",
                "command": "node ${PLUGIN_ROOT}/scripts/codegraph-hook.js SessionStart",
                "timeout": 10
            }
        ],
        "SubagentStart": [
            {
                "type": "command",
                "command": "node ${PLUGIN_ROOT}/scripts/codegraph-hook.js SubagentStart",
                "timeout": 10
            }
        ]
    }
}
