{
    "version": 1,
    "description": "Augment session and subagent starts with codegraph knowledge graph context",
    "hooks": {
        "PostToolUse": [
            {
                "matcher": "Grep|Glob",
                "hooks": [
                    {
                        "type": "command",
                        "command": "node ${PLUGIN_ROOT}/scripts/codegraph-hook PostToolUse"
                    }
                ]
            }
        ],
        "SessionStart": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "node ${PLUGIN_ROOT}/scripts/codegraph-hook SessionStart",
                        "timeout": 10
                    }
                ]
            }
        ],
        "SubagentStart": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "node ${PLUGIN_ROOT}/scripts/codegraph-hook SubagentStart",
                        "timeout": 10
                    }
                ]
            }
        ]
    }
}
