{
    "description": "Augment searches and lifecycle boundaries with codegraph knowledge graph context",
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "Grep|Glob",
                "hooks": [
                    {
                        "type": "command",
                        "command": "node ${PLUGIN_ROOT}/scripts/codegraph-hook.js PreToolUse"
                    }
                ]
            }
        ],
        "SessionStart": [
            {
                "matcher": "startup|resume|clear|compact",
                "hooks": [
                    {
                        "type": "command",
                        "command": "node ${PLUGIN_ROOT}/scripts/codegraph-hook.js SessionStart",
                        "timeout": 10
                    }
                ]
            }
        ],
        "SubagentStart": [
            {
                "matcher": "*",
                "hooks": [
                    {
                        "type": "command",
                        "command": "node ${PLUGIN_ROOT}/scripts/codegraph-hook.js SubagentStart",
                        "timeout": 10
                    }
                ]
            }
        ]
    }
}
