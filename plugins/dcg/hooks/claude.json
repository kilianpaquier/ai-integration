{
    "description": "Block destructive shell and git commands before they run",
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "Bash|PowerShell|Monitor",
                "hooks": [
                    {
                        "type": "command",
                        "command": "dcg"
                    }
                ]
            }
        ]
    }
}
