{
    "description": "Block tool calls that read or write credential/config directories",
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "Bash|Read|Write|Edit|Glob|Grep|NotebookEdit",
                "hooks": [
                    {
                        "type": "command",
                        "command": "node ${CLAUDE_PLUGIN_ROOT}/scripts/protected-paths.js"
                    }
                ]
            }
        ]
    }
}
