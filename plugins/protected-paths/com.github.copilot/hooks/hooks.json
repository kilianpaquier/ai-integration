{
    "version": 1,
    "description": "Block tool calls that read or write credential/config directories",
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "Bash|PowerShell|Read|Write|Edit|Glob|Grep",
                "type": "command",
                "command": "node ${PLUGIN_ROOT}/scripts/protected-paths.js"
            }
        ]
    }
}
